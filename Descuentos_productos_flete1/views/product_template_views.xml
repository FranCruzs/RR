<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_custom" model="ir.ui.view">
        <field name="name">product.template.form.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Añadir campos en la sección de precios -->
            <xpath expr="//group[@name='group_standard_price']" position="inside">
                <group string="Descuentos" name="group_discounts">
                    <field name="d1" string="Descuento 1 (%)"/>
                    <field name="d2" string="Descuento 2 (%)"/>
                    <field name="d3" string="Descuento 3 (%)"/>
                    <field name="d4" string="Descuento 4 (%)"/>
                    <field name="flete" string="Flete (%)"/>
                    <field name="descuento_mayorista" string="Desc. Mayorista (%)"/>
                    <field name="descuento_minorista" string="Desc. Minorista (%)"/>
                    <field name="descuento_total" string="Descuento Total (%)" readonly="1"/>
                    <field name="porcentaje_pagado" string="Porcentaje a Pagar (%)" readonly="1"/>
                    <field name="descuento_neto_final" string="Descuento Neto Final (%)" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
