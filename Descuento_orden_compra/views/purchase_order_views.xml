<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_discount" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.discount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Vista Tree (lista) -->
            <xpath expr="//field[@name='order_line']/tree//field[@name='discount']" position="after">
                <field name="discount1" widget="percentage"/>
                <field name="discount2" widget="percentage"/>
                <field name="discount3" widget="percentage"/>
                <field name="discount4" widget="percentage"/>
            </xpath>
            
            <!-- Vista Form (formulario) -->
            <xpath expr="//field[@name='order_line']/form//field[@name='discount']" position="after">
                <field name="discount1" widget="percentage"/>
                <field name="discount2" widget="percentage"/>
                <field name="discount3" widget="percentage"/>
                <field name="discount4" widget="percentage"/>
            </xpath>

            <!-- Establecemos el campo discount como solo lectura para que sea calculado automáticamente -->
            <xpath expr="//field[@name='order_line']/form//field[@name='discount']" position="replace">
                <field name="discount" readonly="1" widget="percentage"/>
            </xpath>
        </field>
    </record>
</odoo>
