<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acciones -->
    <record id="action_sale_order_history" model="ir.actions.act_window">
        <field name="name">Historial de Órdenes de Venta</field>
        <field name="res_model">sale.order.history</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Este es el historial de versiones de las órdenes de venta
            </p>
        </field>
    </record>

    <!-- Vistas del historial -->
    <record id="view_sale_order_history_tree" model="ir.ui.view">
        <field name="name">sale.order.history.tree</field>
        <field name="model">sale.order.history</field>
        <field name="arch" type="xml">
            <tree>
                <field name="version_name"/>
                <field name="original_order_id"/>
                <field name="user_id"/>
                <field name="change_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sale_order_history_form" model="ir.ui.view">
        <field name="name">sale.order.history.form</field>
        <field name="model">sale.order.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                       <button 
    name="action_restore_version" 
    type="object" 
    string="Restaurar esta versión" 
    class="oe_stat_button" 
    icon="fa-history"
    modifiers='{"invisible": [["original_order_id.state", "in", ["sale", "done"]]]}'
/>

                    </div>
                    <group>
                        <group>
                            <field name="version_name" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="change_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="original_order_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Líneas de Orden">
                            <field name="order_line" readonly="1">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="tax_id" widget="many2many_tags"/>
                                    <field name="price_subtotal"/>
                                    <field name="price_total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Datos Principales">
                            <group>
                                <field name="date_order" readonly="1"/>
                                <field name="validity_date" readonly="1"/>
                                <field name="pricelist_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="payment_term_id" readonly="1"/>
                            
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vistas heredadas de sale.order -->
    <record id="view_order_form_inherit_history" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.history</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="version" readonly="1" class="d-inline ms-2"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Historial de Versiones">
                    <field name="history_ids">
                        <tree>
                            <field name="version_name"/>
                            <field name="user_id"/>
                            <field name="change_date"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_sale_order_history_root" name="Historial Ventas" 
              parent="sale.sale_menu_root" sequence="100"/>
    
    <menuitem id="menu_sale_order_history" name="Historial de Órdenes" 
              parent="menu_sale_order_history_root" 
              action="action_sale_order_history" sequence="10"/>
</odoo>